---
import { Image } from 'astro:assets';
import { site, stats } from '../data/site';
import Icon from './Icon.astro';
import Split from './Split.astro';

// Drop a photo at src/assets/portrait.(jpg|png|webp) and it is used automatically.
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const portrait = Object.values(found)[0]?.default;

const statement =
  'I build apps people keep on their home screen. Real-time social feeds, live sports, connected devices and health products, all from one Flutter codebase that stays clean enough to grow. When the ecosystem is missing a piece, I write it and open-source it. And when the idea is my own, I take it all the way to Google Play.';
const words = statement.split(' ');
---

<section class="about section defer" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <figure class="portrait card" data-reveal data-spot>
      {
        portrait ? (
          <Image
            class="portrait__img"
            src={portrait}
            alt={`Portrait of ${site.name}`}
            widths={[360, 560, 840]}
            sizes="(max-width: 900px) 88vw, 420px"
            quality={82}
          />
        ) : (
          <div class="portrait__blank" aria-hidden="true">
            <span class="portrait__glow"></span>
            <span class="portrait__mono">{site.initials}</span>
            <span class="grain"></span>
          </div>
        )
      }
      <figcaption class="portrait__tag">
        <span class="portrait__name">{site.name}</span>
        <span class="portrait__role mono">
          <Icon name="pin" />
          {site.location}
        </span>
      </figcaption>
    </figure>

    <div class="about__body">
      <p class="eyebrow" data-reveal><span class="eyebrow__dot"></span>About</p>
      <h2 class="h2 about__title" id="about-title" data-split>
        <Split text="Senior Flutter developer. ~Open-source author.~ *Detail person.*" />
      </h2>

      <p class="statement" data-scrub>
        {
          words.map((word, index) => (
            <Fragment>
              <span class="sw">{word}</span>
              {index < words.length - 1 ? ' ' : ''}
            </Fragment>
          ))
        }
      </p>

      <dl class="stats">
        {
          stats.map((stat, index) => (
            <div class="stat" data-reveal style={`--d:${index * 90}ms`}>
              <dt class="stat__label mono">{stat.label}</dt>
              <dd class="stat__value">
                <span data-count={stat.value}>{stat.value}</span>
                {stat.suffix && <span class="stat__suffix">{stat.suffix}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style is:global>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(32px, 6.5vw, 104px);
    align-items: start;
  }

  .portrait {
    position: sticky;
    top: 96px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
  }

  .portrait__img,
  .portrait__blank {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .portrait__img {
    object-fit: cover;
    object-position: 50% 20%;
    transition: transform 1.2s var(--ease-out);
  }

  .portrait:hover .portrait__img {
    transform: scale(1.03);
  }

  .portrait__blank {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #15151a, #09090b 70%);
    overflow: hidden;
  }

  .portrait__glow {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(42% 36% at 30% 24%, rgb(124 200 255 / 0.28), transparent 70%),
      radial-gradient(40% 40% at 76% 82%, rgb(196 208 232 / 0.2), transparent 70%);
    filter: blur(20px);
    animation: drift 16s var(--ease-in-out) infinite alternate;
  }

  .portrait__mono {
    position: relative;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(6rem, 16vw, 11rem);
    line-height: 1;
    letter-spacing: -0.06em;
    background: linear-gradient(180deg, #fff, rgb(255 255 255 / 0.25));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.08em;
  }

  .portrait::after {
    z-index: 2;
  }

  .portrait__tag {
    position: absolute;
    inset: auto 12px 12px;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgb(10 10 12 / 0.6);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .portrait__name {
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .portrait__role {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .portrait__role .icon {
    width: 13px;
    height: 13px;
  }

  @keyframes drift {
    to {
      transform: translate(6%, -5%) rotate(8deg) scale(1.1);
    }
  }

  .about__body {
    display: grid;
    justify-items: start;
    gap: 1.6rem;
    padding-top: clamp(0px, 2vw, 24px);
  }

  .statement {
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
    font-size: clamp(1.35rem, 1.02rem + 1.5vw, 2.15rem);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.028em;
    text-wrap: pretty;
  }

  /* Words light up as the paragraph crosses the viewport */
  html.js .statement .sw {
    color: #7e7e86;
    transition: color 0.5s ease;
  }

  html.js .statement .sw.on,
  html.reveal-all .statement .sw {
    color: var(--text);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: 100%;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 1.5rem 1rem 0 0;
  }

  .stat + .stat {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }

  .stat__value {
    display: flex;
    align-items: baseline;
    font-size: clamp(2.4rem, 1.6rem + 2.6vw, 4rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .stat__suffix {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.7em;
    color: var(--accent);
    margin-left: 0.04em;
  }

  .stat__label {
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      position: relative;
      top: auto;
      width: min(100%, 420px);
    }
  }

  @media (max-width: 560px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat {
      padding-bottom: 1.5rem;
    }

    .stat:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
