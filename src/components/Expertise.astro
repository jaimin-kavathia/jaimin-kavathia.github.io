---
import { expertise, toolbox } from '../data/expertise';
import Icon from './Icon.astro';
import Split from './Split.astro';

const area = (id: (typeof expertise)[number]['id']) => expertise.find((item) => item.id === id)!;

const platforms = [
  { icon: 'device', label: 'Android' },
  { icon: 'device', label: 'iOS' },
  { icon: 'browser', label: 'Web' },
  { icon: 'laptop', label: 'macOS' },
  { icon: 'monitor', label: 'Windows' },
] as const;

const services = ['Auth', 'Database', 'Storage', 'Push', 'Maps'];
---

<section class="expertise section defer" id="expertise" aria-labelledby="expertise-title">
  <div class="container">
    <header class="shead">
      <p class="eyebrow" data-reveal><span class="eyebrow__dot"></span>Expertise</p>
      <h2 class="h2" id="expertise-title" data-split>
        <Split text="What I bring ~to a product,~ *end to end.*" />
      </h2>
    </header>

    <div class="bento">
      <!-- Platforms -->
      <article class="tile tile--platforms card" data-spot data-reveal data-play>
        <div class="tile__art art-platforms" aria-hidden="true">
          {
            platforms.map((platform, index) => (
              <span class="art-platforms__item" style={`--n:${index}`}>
                <Icon name={platform.icon} />
                <em class="mono">{platform.label}</em>
              </span>
            ))
          }
        </div>
        <div class="tile__text">
          <h3 class="tile__title">{area('platforms').title}</h3>
          <p>{area('platforms').body}</p>
        </div>
      </article>

      <!-- Architecture -->
      <article class="tile tile--architecture card" data-spot data-reveal data-play style="--d:90ms">
        <div class="tile__art art-flow" aria-hidden="true">
          <span class="art-flow__node mono">Event</span>
          <span class="art-flow__wire"><i></i></span>
          <span class="art-flow__node art-flow__node--core mono">BLoC</span>
          <span class="art-flow__wire"><i></i></span>
          <span class="art-flow__node mono">State</span>
        </div>
        <div class="tile__text">
          <h3 class="tile__title">{area('architecture').title}</h3>
          <p>{area('architecture').body}</p>
          <ul class="chips">{area('architecture').tags.map((tag) => <li class="chip">{tag}</li>)}</ul>
        </div>
      </article>

      <!-- Real-time -->
      <article class="tile tile--third card" data-spot data-reveal data-play>
        <div class="tile__art art-live" aria-hidden="true">
          <span class="art-live__badge mono"><i></i>Live</span>
          <svg viewBox="0 0 320 90" preserveAspectRatio="none">
            <path
              class="art-live__trace"
              d="M0 60h44l10-34 14 52 12-40 9 22h36l10-46 14 68 11-38 8 16h40l10-30 13 44 10-26 9 12h50"
            ></path>
            <path
              class="art-live__pulse"
              pathLength="1"
              d="M0 60h44l10-34 14 52 12-40 9 22h36l10-46 14 68 11-38 8 16h40l10-30 13 44 10-26 9 12h50"
            ></path>
          </svg>
        </div>
        <div class="tile__text">
          <h3 class="tile__title">{area('realtime').title}</h3>
          <p>{area('realtime').body}</p>
          <ul class="chips">{area('realtime').tags.map((tag) => <li class="chip">{tag}</li>)}</ul>
        </div>
      </article>

      <!-- Hardware -->
      <article class="tile tile--third card" data-spot data-reveal data-play style="--d:90ms">
        <div class="tile__art art-radar" aria-hidden="true">
          <span class="art-radar__ring"></span>
          <span class="art-radar__ring"></span>
          <span class="art-radar__ring"></span>
          <span class="art-radar__core"><Icon name="chip" /></span>
          <span class="art-radar__peer" style="--x:18%;--y:30%"></span>
          <span class="art-radar__peer" style="--x:80%;--y:24%"></span>
          <span class="art-radar__peer" style="--x:72%;--y:78%"></span>
        </div>
        <div class="tile__text">
          <h3 class="tile__title">{area('hardware').title}</h3>
          <p>{area('hardware').body}</p>
          <ul class="chips">{area('hardware').tags.map((tag) => <li class="chip">{tag}</li>)}</ul>
        </div>
      </article>

      <!-- Native -->
      <article class="tile tile--third card" data-spot data-reveal style="--d:180ms">
        <div class="tile__art art-code" aria-hidden="true">
          <pre
            class="mono"><span class="tk-k">const</span> channel =
    <span class="tk-t">MethodChannel</span>(<span class="tk-p">'app/native'</span>);
<span class="tk-k">await</span> channel
    .<span class="tk-f">invokeMethod</span>(<span class="tk-p">'startScan'</span>);<i class="art-code__caret"></i></pre>
          <div class="art-code__langs mono"><span>Dart</span><span>Kotlin</span><span>Swift</span></div>
        </div>
        <div class="tile__text">
          <h3 class="tile__title">{area('native').title}</h3>
          <p>{area('native').body}</p>
        </div>
      </article>

      <!-- Growth -->
      <article class="tile tile--half card" data-spot data-reveal data-play>
        <div class="tile__art art-bars" aria-hidden="true">
          {[34, 48, 42, 60, 56, 74, 68, 88, 100].map((height, index) => <i style={`--h:${height}%;--n:${index}`} />)}
        </div>
        <div class="tile__text">
          <h3 class="tile__title">{area('growth').title}</h3>
          <p>{area('growth').body}</p>
          <ul class="chips">{area('growth').tags.map((tag) => <li class="chip">{tag}</li>)}</ul>
        </div>
      </article>

      <!-- Backend -->
      <article class="tile tile--half card" data-spot data-reveal data-play style="--d:90ms">
        <div class="tile__art art-services" aria-hidden="true">
          {
            services.map((service, index) => (
              <span class="mono" style={`--n:${index}`}>
                <i />
                {service}
              </span>
            ))
          }
        </div>
        <div class="tile__text">
          <h3 class="tile__title">{area('backend').title}</h3>
          <p>{area('backend').body}</p>
          <ul class="chips">{area('backend').tags.map((tag) => <li class="chip">{tag}</li>)}</ul>
        </div>
      </article>
    </div>

    <div class="toolbox" data-reveal>
      <h3 class="toolbox__title mono">Toolbox</h3>
      <dl class="toolbox__list">
        {
          toolbox.map((group) => (
            <div class="toolbox__row">
              <dt class="mono">{group.label}</dt>
              <dd>
                {group.items.map((item, index) => (
                  <Fragment>
                    <span>{item}</span>
                    {index < group.items.length - 1 && <i aria-hidden="true">/</i>}
                  </Fragment>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style is:global>
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 20px);
  }

  .tile {
    display: flex;
    flex-direction: column;
    grid-column: span 4;
    border-radius: 24px;
  }

  .tile--platforms {
    grid-column: span 7;
  }

  .tile--architecture {
    grid-column: span 5;
  }

  .tile--half {
    grid-column: span 6;
  }

  .tile:not(.is-playing) .tile__art * {
    animation-play-state: paused !important;
  }

  .tile__art {
    position: relative;
    display: grid;
    flex: 1 0 190px;
    place-items: center;
    min-height: 190px;
    border-bottom: 1px solid var(--line);
    background: rgb(0 0 0 / 0.28);
    overflow: hidden;
  }

  .tile__text {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    padding: clamp(20px, 2.4vw, 30px);
    color: var(--text-2);
    font-size: 0.95rem;
  }

  .tile__title {
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.45rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .tile__text .chips {
    margin-top: 0.4rem;
  }

  /* Platforms: a light sweeps across the five targets */
  .art-platforms {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1.4vw, 16px);
    padding-inline: 20px;
  }

  .art-platforms__item {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    width: clamp(56px, 8.4vw, 92px);
    padding: 1.1rem 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgb(255 255 255 / 0.03);
    color: var(--text-2);
    animation: platform-lit 5s var(--ease-in-out) infinite;
    animation-delay: calc(var(--n) * 0.45s);
  }

  .art-platforms__item .icon {
    width: clamp(22px, 2.6vw, 30px);
    height: clamp(22px, 2.6vw, 30px);
    stroke-width: 1.3;
  }

  .art-platforms__item em {
    font-size: 0.6rem;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @keyframes platform-lit {
    0%,
    30%,
    100% {
      border-color: var(--line);
      background: rgb(255 255 255 / 0.03);
      color: var(--text-2);
      transform: none;
    }
    12% {
      border-color: rgb(124 200 255 / 0.6);
      background: rgb(124 200 255 / 0.12);
      color: var(--text);
      transform: translateY(-6px);
    }
  }

  /* Architecture: data travelling Event -> BLoC -> State */
  .art-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 16px;
  }

  .art-flow__node {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.04);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .art-flow__node--core {
    border-color: rgb(124 200 255 / 0.5);
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: 0 0 40px -6px rgb(124 200 255 / 0.5);
  }

  .art-flow__wire {
    position: relative;
    width: clamp(26px, 4vw, 54px);
    height: 1px;
    background: var(--line-2);
  }

  .art-flow__wire i {
    position: absolute;
    top: -2.5px;
    left: 0;
    width: 100%;
    height: 6px;
    animation: wire 2.4s var(--ease-in-out) infinite;
  }

  .art-flow__wire i::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .art-flow__wire:nth-of-type(4) i {
    animation-delay: 1.2s;
  }

  @keyframes wire {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(calc(100% - 6px));
    }
  }

  /* Real-time: a signal that keeps drawing itself */
  .art-live svg {
    width: 100%;
    height: 90px;
  }

  .art-live path {
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .art-live__trace {
    stroke: rgb(255 255 255 / 0.14);
  }

  .art-live__pulse {
    stroke: var(--accent);
    stroke-dasharray: 0.3 0.7;
    filter: drop-shadow(0 0 6px rgb(124 200 255 / 0.7));
    animation: live-line 3.6s linear infinite;
  }

  .art-live__badge {
    position: absolute;
    top: 14px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .art-live__badge i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ff6b6b;
    animation: blink 1.4s steps(2, jump-none) infinite;
  }

  @keyframes live-line {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes blink {
    to {
      opacity: 0.25;
    }
  }

  /* Hardware: discovery rings */
  .art-radar__ring {
    position: absolute;
    width: 70px;
    height: 70px;
    border: 1px solid rgb(124 200 255 / 0.55);
    border-radius: 50%;
    opacity: 0;
    animation: radar 3.6s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }

  .art-radar__ring:nth-child(2) {
    animation-delay: 1.2s;
  }

  .art-radar__ring:nth-child(3) {
    animation-delay: 2.4s;
  }

  .art-radar__core {
    position: relative;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 1px solid rgb(124 200 255 / 0.5);
    border-radius: 16px;
    background: #0d1620;
    color: var(--accent);
  }

  .art-radar__core .icon {
    width: 24px;
    height: 24px;
    stroke-width: 1.4;
  }

  .art-radar__peer {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text);
    box-shadow: 0 0 0 4px rgb(255 255 255 / 0.1);
    animation: blink 2.2s ease-in-out infinite alternate;
  }

  @keyframes radar {
    0% {
      opacity: 0.9;
      transform: scale(0.8);
    }
    100% {
      opacity: 0;
      transform: scale(4.2);
    }
  }

  /* Native: a platform channel call */
  .art-code {
    align-content: center;
    justify-items: start;
    gap: 0.9rem;
    padding: 0 clamp(16px, 2vw, 24px);
  }

  .art-code pre {
    max-width: 100%;
    font-size: 0.74rem;
    line-height: 1.75;
    color: var(--text);
    overflow: hidden;
  }

  .art-code__caret {
    display: inline-block;
    width: 6px;
    height: 1.05em;
    margin-left: 3px;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1.1s steps(2, jump-none) infinite;
  }

  .art-code__langs {
    display: flex;
    gap: 0.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .art-code__langs span {
    padding: 0.22rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* Growth: bars rising */
  .art-bars {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(6px, 1vw, 12px);
    padding: 28px 24px 0;
  }

  .art-bars i {
    width: clamp(16px, 2.4vw, 30px);
    height: var(--h);
    border-radius: 8px 8px 0 0;
    background: linear-gradient(180deg, rgb(124 200 255 / 0.85), rgb(124 200 255 / 0.06));
    transform-origin: 50% 100%;
    animation: bar 4.5s var(--ease-out) infinite;
    animation-delay: calc(var(--n) * 90ms);
  }

  .art-bars i:last-child {
    background: linear-gradient(180deg, #fff, rgb(255 255 255 / 0.08));
  }

  @keyframes bar {
    0% {
      transform: scaleY(0.08);
    }
    28%,
    88% {
      transform: none;
    }
    100% {
      transform: scaleY(0.08);
    }
  }

  /* Backend: services coming online */
  .art-services {
    display: flex;
    flex-wrap: wrap;
    place-content: center;
    gap: 0.5rem;
    padding: 0 clamp(16px, 4vw, 56px);
  }

  .art-services span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.03);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--text-2);
    animation: service 6s ease infinite;
    animation-delay: calc(var(--n) * 0.5s);
  }

  .art-services i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  @keyframes service {
    0%,
    8% {
      border-color: var(--line);
      color: var(--text-2);
    }
    16%,
    84% {
      border-color: rgb(127 227 176 / 0.4);
      color: var(--ok);
    }
    92%,
    100% {
      border-color: var(--line);
      color: var(--text-2);
    }
  }

  /* Toolbox */
  .toolbox {
    display: grid;
    grid-template-columns: minmax(0, 0.3fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 64px);
    margin-top: clamp(48px, 7vw, 96px);
  }

  .toolbox__title {
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-2);
    padding-top: 1.35rem;
  }

  .toolbox__row {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.15rem;
    border-top: 1px solid var(--line);
    transition: background-color 0.4s;
  }

  .toolbox__row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .toolbox__row dt {
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .toolbox__row dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.7rem;
    font-size: clamp(1.02rem, 0.94rem + 0.4vw, 1.3rem);
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .toolbox__row dd i {
    font-style: normal;
    color: var(--text-3);
    opacity: 0.5;
  }

  .toolbox__row dd span {
    transition: color 0.3s;
  }

  @media (hover: hover) {
    .toolbox__row:hover dd span {
      color: var(--text-2);
    }

    .toolbox__row dd span:hover {
      color: var(--accent);
    }
  }

  @media (max-width: 980px) {
    .tile,
    .tile--platforms,
    .tile--architecture,
    .tile--half {
      grid-column: span 6;
    }

    .tile--platforms {
      grid-column: span 12;
    }
  }

  @media (max-width: 680px) {
    .tile,
    .tile--platforms,
    .tile--architecture,
    .tile--half {
      grid-column: span 12;
    }

    .toolbox {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .toolbox__title {
      padding: 0 0 1rem;
    }

    .toolbox__row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
