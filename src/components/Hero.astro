---
import { site, yearsOfExperience } from '../data/site';
import Icon from './Icon.astro';
import Split from './Split.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="stage" data-stage data-play>
    <div class="stage__fallback" aria-hidden="true"></div>
    <canvas class="stage__canvas" data-smoke aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>
    <div class="stage__shade" aria-hidden="true"></div>

    <p class="hud hud--tl mono" aria-hidden="true">Portfolio / {new Date().getFullYear()}</p>
    <p class="hud hud--tr mono">
      <Icon name="pin" />
      <span>{site.location}</span>
      <span class="hud__sep" aria-hidden="true"></span>
      <span><span data-clock>--:--</span> IST</span>
    </p>
    <p class="hud hud--bl mono" aria-hidden="true">{site.coordinates}</p>
    <a class="hud hud--br mono" href="#about">
      Scroll
      <span class="hud__arrow"><Icon name="arrow-down" /></span>
    </a>

    <div class="hero__content" data-stage-content>
      <!-- One heading: the name and role (what people search for), then the headline. -->
      <h1 class="hero__h1" id="hero-title">
        <span class="eyebrow hero__badge">
          <span class="pulse" aria-hidden="true"></span>
          <span>{site.name} · {site.role}<span class="hero__since">, {site.country}</span></span>
        </span>
        <span class="display hero__title">
          <Split text="Flutter apps that feel *native* ~on every screen.~" />
        </span>
      </h1>

      <p class="lede hero__lede">
        I'm {site.name}, a senior Flutter developer based in {site.city}, {site.country}. For {yearsOfExperience}+
        years I've been building fast, dependable apps for Android, iOS, web and desktop, and open-sourcing the
        pieces I wished already existed.
      </p>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#packages" data-magnetic>
          Explore my packages
          <span class="btn__icon" aria-hidden="true">
            <Icon name="arrow-right" /><Icon name="arrow-right" />
          </span>
        </a>
        <a class="btn btn--plain" href="#contact" data-magnetic>Get in touch</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero {
    padding: 74px 12px 0;
  }

  .stage {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: max(580px, calc(100svh - 86px));
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: #060608;
    overflow: hidden;
    transform-origin: 50% 100%;
    transform: scale(calc(1 - var(--p, 0) * 0.045));
  }

  .stage__fallback,
  .stage__canvas,
  .stage__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Shown until WebGL takes over, and kept if it never does */
  .stage__fallback {
    z-index: -4;
    background:
      radial-gradient(55% 60% at 8% 12%, rgb(196 208 232 / 0.3), transparent 70%),
      radial-gradient(50% 65% at 96% 82%, rgb(166 192 236 / 0.26), transparent 70%),
      radial-gradient(38% 42% at 88% 6%, rgb(124 200 255 / 0.16), transparent 70%),
      radial-gradient(40% 45% at 4% 96%, rgb(255 179 138 / 0.08), transparent 70%);
    filter: blur(24px);
  }

  .stage__canvas {
    z-index: -3;
    opacity: 0;
    transition: opacity 1.8s ease;
  }

  .stage__canvas.is-live {
    opacity: 1;
  }

  .stage .grain {
    z-index: -2;
    animation: grain-shift 0.9s steps(6) infinite;
  }

  .stage:not(.is-playing) .grain,
  .stage:not(.is-playing) .hud__arrow .icon,
  .stage:not(.is-playing) .pulse::after {
    animation-play-state: paused;
  }

  .stage__shade {
    z-index: -1;
    background:
      radial-gradient(58% 48% at 50% 48%, rgb(5 5 6 / 0.55), transparent 80%),
      linear-gradient(180deg, rgb(5 5 6 / 0.3), transparent 20%, transparent 74%, rgb(5 5 6 / 0.5));
  }

  @keyframes grain-shift {
    0% {
      transform: translate(0, 0);
    }
    20% {
      transform: translate(-3%, 2%);
    }
    40% {
      transform: translate(2%, -4%);
    }
    60% {
      transform: translate(-4%, -1%);
    }
    80% {
      transform: translate(3%, 3%);
    }
    100% {
      transform: translate(0, 0);
    }
  }

  .hero__content {
    display: grid;
    justify-items: center;
    gap: clamp(1.4rem, 2.6vw, 2rem);
    max-width: 1080px;
    padding: 96px clamp(18px, 5vw, 64px) 112px;
    text-align: center;
    opacity: calc(1 - var(--p, 0) * 1.35);
    transform: translateY(calc(var(--p, 0) * 70px));
  }

  .hero__badge {
    background: rgb(10 10 12 / 0.5);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    animation: fade-up 1s var(--ease-out) both;
  }

  .hero__h1 {
    display: grid;
    justify-items: center;
    gap: clamp(1.4rem, 2.6vw, 2rem);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .hero__title {
    display: block;
  }

  .hero__title .w {
    animation: rise-in 1.1s var(--ease-out) both;
    animation-delay: calc(var(--i) * 65ms + 120ms);
  }

  .hero__lede {
    max-width: 58ch;
    animation: fade-up 1.1s var(--ease-out) 0.62s both;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 0.35rem;
    animation: fade-up 1.1s var(--ease-out) 0.76s both;
  }

  /* Corner read-outs */
  .hud {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2);
    animation: fade-up 1.2s var(--ease-out) 1s both;
  }

  .hud .icon {
    width: 13px;
    height: 13px;
  }

  .hud--tl {
    top: 24px;
    left: 28px;
  }

  .hud--tr {
    top: 24px;
    right: 28px;
  }

  .hud--bl {
    bottom: 24px;
    left: 28px;
  }

  .hud--br {
    right: 20px;
    bottom: 16px;
    gap: 0.7rem;
    padding: 0.35rem 0.35rem 0.35rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(10 10 12 / 0.45);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--text);
    transition: border-color 0.3s;
  }

  .hud--br:hover {
    border-color: rgb(255 255 255 / 0.3);
  }

  .hud__sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-3);
  }

  .hud__arrow {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
  }

  .hud__arrow .icon {
    animation: nudge-down 2.2s var(--ease-in-out) infinite;
  }

  @keyframes nudge-down {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-inline: 8px;
    }

    .stage {
      min-height: max(560px, calc(100svh - 82px));
      border-radius: 22px;
    }

    .hero__content {
      padding: 84px 18px 96px;
    }

    .hud--tl,
    .hud--bl {
      display: none;
    }

    .hud--tr {
      top: 20px;
      right: auto;
      left: 50%;
      width: max-content;
      translate: -50% 0;
    }

    .hud--br {
      right: 50%;
      translate: 50% 0;
    }

    .hero__cta .btn {
      --h: 50px;
    }

    .hero__since {
      display: none;
    }

    .hero__badge {
      font-size: 0.6rem;
      letter-spacing: 0.05em;
      text-align: center;
    }
  }
</style>
