---
import { apps } from '../data/apps';
import { hirePath } from '../data/hire';
import { packageLinks } from '../data/packages';
import { profiles, site } from '../data/site';
import Icon from './Icon.astro';

/** Every page links to every other page from here, with descriptive link text. */
const groups = [
  {
    title: 'Work with me',
    links: [
      { label: 'Hire a freelance Flutter developer', href: hirePath },
      { label: 'Flutter expertise', href: '/#expertise' },
      { label: 'Career journey', href: '/#journey' },
    ],
  },
  {
    title: 'Flutter packages',
    links: packageLinks.map((pkg) => ({ label: pkg.name, href: pkg.path })),
  },
  {
    title: 'Android apps',
    links: apps.map((app) => ({ label: `${app.name}: ${app.subtitle}`, href: `/apps/${app.detail.slug}/` })),
  },
  {
    title: 'Contact',
    links: [
      { label: site.email, href: `mailto:${site.email}` },
      { label: site.phone, href: `tel:${site.phoneHref}` },
    ],
  },
];
---

<footer class="footer defer">
  <nav class="container footer__nav" aria-label="Site">
    <div class="footer__about">
      <p class="footer__name">{site.name}</p>
      <p>{site.role} in {site.city}, {site.country}. Flutter apps for Android, iOS, web and desktop.</p>
      <ul class="footer__profiles" aria-label="Profiles">
        {
          profiles.map((profile) => (
            <li>
              <a href={profile.href} target="_blank" rel="me noopener">
                {profile.label}
                <Icon name="arrow-up-right" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    {
      groups.map((group) => (
        <div>
          <p class="footer__label mono">{group.title}</p>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="container footer__row">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p class="footer__made">Designed and built in {site.city}</p>
    <a class="footer__top" href="#main">
      Back to top
      <span aria-hidden="true"><Icon name="arrow-up" /></span>
    </a>
  </div>
  <p class="footer__wordmark" aria-hidden="true">{site.name}</p>
</footer>

<style is:global>
  .footer {
    padding-top: clamp(48px, 7vw, 96px);
    overflow: hidden;
  }

  .footer.defer:not(.is-rendered) {
    contain-intrinsic-size: auto 620px;
  }

  .footer__nav {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) repeat(3, minmax(0, 1fr)) minmax(0, 1.2fr);
    gap: clamp(24px, 3vw, 48px);
    padding-bottom: clamp(36px, 5vw, 64px);
    margin-bottom: clamp(20px, 3vw, 32px);
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--text-2);
  }

  .footer__about {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    max-width: 34ch;
  }

  .footer__name {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* Profile links, as small pills under the name */
  .footer__nav .footer__profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.5rem;
  }

  .footer__profiles a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.36rem 0.6rem 0.36rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.025);
    font-size: 0.82rem;
    color: var(--text);
    transition:
      border-color 0.3s,
      background-color 0.3s;
  }

  .footer__profiles a:hover {
    border-color: var(--line-2);
    background: rgb(255 255 255 / 0.06);
  }

  .footer__profiles .icon {
    width: 13px;
    height: 13px;
    color: var(--text-2);
    transition:
      transform 0.4s var(--ease-out),
      color 0.3s;
  }

  .footer__profiles a:hover .icon {
    color: var(--accent);
    transform: translate(1px, -1px);
  }

  .footer__label {
    margin-bottom: 0.9rem;
    font-size: 0.64rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .footer__nav ul {
    display: grid;
    gap: 0.55rem;
  }

  .footer__nav a {
    overflow-wrap: break-word;
    transition: color 0.3s;
  }

  .footer__nav a:hover {
    color: var(--text);
  }

  .footer__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .footer__top {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
  }

  .footer__top span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.5s var(--ease-out);
  }

  .footer__top .icon {
    width: 14px;
    height: 14px;
  }

  .footer__top:hover span {
    background: var(--text);
    color: #08080a;
    transform: translateY(-3px);
  }

  .footer__wordmark {
    margin-top: clamp(20px, 3vw, 40px);
    margin-bottom: -0.17em;
    font-size: clamp(2.6rem, 12.6vw, 15rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.055em;
    text-align: center;
    white-space: nowrap;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.26), rgb(255 255 255 / 0.02) 82%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
  }

  @media (max-width: 1000px) {
    .footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 680px) {
    .footer__row {
      grid-template-columns: 1fr auto;
    }

    .footer__made {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .footer__nav {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
