---
import { site } from '../data/site';
import { apps } from '../data/apps';
import Icon from './Icon.astro';

const links = [
  { href: '#about', label: 'About' },
  { href: '#packages', label: 'Packages' },
  ...(apps.length ? [{ href: '#apps', label: 'Apps' }] : []),
  { href: '#expertise', label: 'Expertise' },
  { href: '#journey', label: 'Journey' },
];
---

<header class="nav" data-nav>
  <a class="nav__brand pill" href="#top" aria-label={`${site.name}, back to top`}>
    <span class="nav__mark" aria-hidden="true">{site.initials}</span>
    <span class="nav__name">{site.name}</span>
  </a>

  <nav class="nav__links pill" aria-label="Sections" data-nav-links>
    <span class="nav__indicator" aria-hidden="true"></span>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <a class="nav__cta pill" href="#contact">
    <span class="pulse" aria-hidden="true"></span>
    Let's talk
  </a>

  <button
    class="nav__toggle pill"
    type="button"
    aria-expanded="false"
    aria-controls="menu"
    data-menu-toggle
  >
    <span class="nav__toggle-bars" aria-hidden="true"><i></i><i></i></span>
    <span data-menu-label>Menu</span>
  </button>
</header>

<div class="menu" id="menu" data-menu inert>
  <nav class="menu__links" aria-label="Sections">
    {
      [...links, { href: '#contact', label: 'Contact' }].map((link, index) => (
        <a href={link.href} style={`--i:${index}`}>
          <span class="menu__index mono">0{index + 1}</span>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="menu__foot">
    <a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
    <a href={`tel:${site.phoneHref}`}><Icon name="phone" />{site.phone}</a>
  </div>
</div>

<style is:global>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    padding: 14px max(12px, calc(var(--gutter) - 8px));
    pointer-events: none;
  }

  .nav > * {
    pointer-events: auto;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(13 13 16 / 0.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    backdrop-filter: blur(18px) saturate(1.6);
    transition:
      background-color 0.4s,
      border-color 0.4s;
  }

  .nav.is-scrolled .pill {
    border-color: var(--line-2);
    background: rgb(13 13 16 / 0.78);
  }

  .nav__brand {
    justify-self: start;
    gap: 0.7rem;
    padding: 0 1.15rem 0 6px;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .nav__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--text);
    color: #08080a;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    letter-spacing: -0.04em;
    padding-right: 1px;
    transition: transform 0.6s var(--ease-out);
  }

  .nav__brand:hover .nav__mark {
    transform: rotate(-12deg) scale(1.06);
  }

  .nav__links {
    position: relative;
    grid-column: 2;
    padding: 0 5px;
  }

  .nav__links a {
    position: relative;
    z-index: 1;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--text-2);
    transition: color 0.3s;
  }

  .nav__links a:hover,
  .nav__links a[aria-current='true'] {
    color: var(--text);
  }

  .nav__indicator {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 0;
    width: var(--w, 0px);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.09);
    opacity: var(--o, 0);
    transform: translateX(var(--x, 0px));
    transition:
      transform 0.55s var(--ease-out),
      width 0.55s var(--ease-out),
      opacity 0.3s;
  }

  .nav__cta {
    grid-column: 3;
    justify-self: end;
    gap: 0.65rem;
    padding: 0 1.2rem 0 1rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .nav__cta:hover {
    border-color: rgb(255 255 255 / 0.3);
  }

  .nav__toggle {
    display: none;
    grid-column: 3;
    justify-self: end;
    gap: 0.65rem;
    padding: 0 1.1rem 0 1rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .nav__toggle-bars {
    position: relative;
    width: 16px;
    height: 10px;
  }

  .nav__toggle-bars i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-out),
      top 0.45s var(--ease-out);
  }

  .nav__toggle-bars i:first-child {
    top: 1px;
  }

  .nav__toggle-bars i:last-child {
    top: 8px;
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-bars i:first-child {
    top: 4.5px;
    transform: rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-bars i:last-child {
    top: 4.5px;
    transform: rotate(-45deg);
  }

  /* Full-screen menu for small screens */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 104px var(--gutter) 32px;
    background: rgb(5 5 6 / 0.9);
    -webkit-backdrop-filter: blur(28px);
    backdrop-filter: blur(28px);
    opacity: 0;
    visibility: hidden;
    overflow-y: auto;
    transition:
      opacity 0.45s var(--ease-out),
      visibility 0.45s;
  }

  .menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  .menu__links {
    display: grid;
  }

  .menu__links a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(2rem, 9.5vw, 3.25rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.04em;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.7s var(--ease-out);
  }

  .menu.is-open .menu__links a {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 55ms + 80ms);
  }

  .menu__index {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-3);
  }

  .menu__foot {
    display: grid;
    gap: 0.75rem;
    color: var(--text-2);
    font-size: 0.95rem;
  }

  .menu__foot a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  @media (max-width: 900px) {
    .nav {
      grid-template-columns: 1fr auto;
    }

    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__toggle {
      display: inline-flex;
      grid-column: 2;
    }
  }

  @media (min-width: 901px) {
    .menu {
      display: none;
    }
  }

  @media (max-width: 340px) {
    .nav__name {
      display: none;
    }

    .nav__brand {
      padding-right: 6px;
    }
  }
</style>
