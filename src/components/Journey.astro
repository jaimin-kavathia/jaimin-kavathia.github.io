---
import { journey } from '../data/journey';
import { site, yearsOfExperience } from '../data/site';
import Split from './Split.astro';

const kinds = { career: 'Career', award: 'Award', release: 'Release', learning: 'Learning' } as const;
---

<section class="journey section defer" id="journey" aria-labelledby="journey-title">
  <div class="container journey__grid">
    <header class="shead journey__head">
      <p class="eyebrow" data-reveal><span class="eyebrow__dot"></span>Journey</p>
      <h2 class="h2" id="journey-title" data-split>
        <Split text={`${yearsOfExperience} years in, ~and still~ *shipping.*`} />
      </h2>
      <p class="lede" data-reveal style="--d:120ms">
        From a first Flutter project in {site.careerStartYear} to senior developer, package author and independent
        app publisher.
      </p>
    </header>

    <div class="timeline" data-progress>
      <span class="timeline__rail" aria-hidden="true"><i></i></span>
      <ol class="timeline__list">
      {
        journey.map((item) => (
          <li class:list={['milestone', `milestone--${item.kind}`]} data-reveal>
            <span class="milestone__dot" aria-hidden="true" />
            <p class="milestone__when mono">{item.when}</p>
            <div class="milestone__body">
              <p class="milestone__kind mono">{kinds[item.kind]}</p>
              <h3 class="milestone__title">{item.title}</h3>
              <p class="milestone__text">{item.body}</p>
            </div>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

<style is:global>
  .journey__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .journey__head {
    position: sticky;
    top: 112px;
    margin-bottom: 0;
  }

  .timeline {
    position: relative;
    padding-left: 32px;
  }

  .timeline__list {
    display: grid;
  }

  .timeline__rail {
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 5px;
    width: 1px;
    background: var(--line-2);
  }

  .timeline__rail i {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--accent), #fff);
    box-shadow: 0 0 12px rgb(124 200 255 / 0.7);
    transform: scaleY(var(--progress, 0));
    transform-origin: 50% 0;
    transition: transform 0.25s linear;
  }

  .milestone {
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: clamp(12px, 2.4vw, 32px);
    padding-block: clamp(20px, 2.6vw, 30px);
    border-bottom: 1px solid var(--line);
  }

  .milestone:first-of-type {
    padding-top: 0;
  }

  .milestone:last-of-type {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .milestone__dot {
    position: absolute;
    top: calc(clamp(20px, 2.6vw, 30px) + 6px);
    left: -32px;
    width: 11px;
    height: 11px;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--text-3);
    box-shadow: 0 0 0 1px var(--line-2);
    transition:
      background-color 0.6s,
      box-shadow 0.6s;
  }

  .milestone:first-of-type .milestone__dot {
    top: 6px;
  }

  .milestone.is-in .milestone__dot {
    background: var(--accent);
    box-shadow:
      0 0 0 1px rgb(124 200 255 / 0.6),
      0 0 16px rgb(124 200 255 / 0.8);
  }

  .milestone__when {
    padding-top: 0.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .milestone__body {
    display: grid;
    gap: 0.45rem;
  }

  .milestone__kind {
    justify-self: start;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .milestone--release .milestone__kind {
    color: var(--accent);
  }

  .milestone--award .milestone__kind {
    color: var(--warm);
  }

  .milestone__title {
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.6rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .milestone__text {
    max-width: 52ch;
    color: var(--text-2);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .journey__grid {
      grid-template-columns: 1fr;
    }

    .journey__head {
      position: static;
      margin-bottom: clamp(12px, 3vw, 28px);
    }
  }

  @media (max-width: 520px) {
    .milestone {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
