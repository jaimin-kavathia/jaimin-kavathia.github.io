---
import { Font } from 'astro:assets';
import '../styles/base.css';
import { site } from '../data/site';
import { graph, personNode, websiteNode } from '../lib/schema';

interface Props {
  /** Full <title>, as it should read in search results. */
  title?: string;
  description?: string;
  /** Extra schema.org nodes for this page. Person and WebSite are always included. */
  schema?: Record<string, unknown>[];
  /** Open Graph type. */
  type?: 'website' | 'profile' | 'article';
  /** Keep the page out of search results. */
  noindex?: boolean;
}

const { title = site.title, description = site.description, schema = [], type = 'website', noindex = false } = Astro.props;

const origin = Astro.site!;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL('/og.png', origin).href;
const portrait = new URL('/jaimin-kavathia.jpg', origin).href;
const structured = graph([personNode(origin, portrait), websiteNode(origin), ...schema]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    {site.bingSiteVerification && <meta name="msvalidate.01" content={site.bingSiteVerification} />}
    <meta name="theme-color" content="#050506" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta property="og:locale" content="en_IN" />
    {
      type === 'profile' && (
        <Fragment>
          <meta property="profile:first_name" content={site.firstName} />
          <meta property="profile:last_name" content={site.lastName} />
        </Fragment>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={structured} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" />

    <script is:inline>
      // Mark that scripting works before first paint, so reveal styles can hide
      // content safely. If the main bundle never arrives, show everything.
      (function (root) {
        root.classList.add('js');
        // Arriving at an anchor, or back at a restored scroll position, needs
        // real section heights straight away.
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (location.hash || (nav && nav.type !== 'navigate')) root.classList.add('no-defer');
        setTimeout(function () {
          if (!window.__siteReady) root.classList.add('reveal-all');
        }, 3500);
      })(document.documentElement);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <div class="sr-only" aria-live="polite" data-announce></div>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
