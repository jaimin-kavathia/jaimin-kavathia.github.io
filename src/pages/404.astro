---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Base title={`Page not found — ${site.name}`} description="This page does not exist.">
  <main id="main" class="lost">
    <p class="eyebrow"><span class="eyebrow__dot"></span>Error 404</p>
    <h1 class="display">This screen <span class="w em">isn't built yet.</span></h1>
    <p class="lede">The page you were looking for does not exist, or it has moved.</p>
    <a class="btn btn--primary" href="/">
      Back to the homepage
      <span class="btn__icon" aria-hidden="true"><Icon name="arrow-right" /><Icon name="arrow-right" /></span>
    </a>
  </main>
</Base>

<style is:global>
  .lost {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.75rem;
    min-height: 100svh;
    padding: var(--gutter);
    text-align: center;
  }
</style>
